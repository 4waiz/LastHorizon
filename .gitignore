# Installed dependencies. Reproduced from package-lock.json by `npm ci`, which
# is what CI runs. These were tracked until Phase 4 and it made ordinary branch
# work unsafe: 7,860 files, including binaries like esbuild.exe that Windows
# holds open, so a checkout or merge could abort part-way through.
node_modules/

# Build output. Regenerated by `npm run build`, which both CI jobs run for
# themselves; the workflow only ever keeps dist/ as a short-lived artifact.
# Tracked until Phase 4, where it was the last thing dirtying the tree on every
# build, and let the committed bundle drift from the source that made it.
dist/

# Dev-only screenshot sink (see the lh-shot-sink plugin in vite.config.ts).
.shots/

# MCP server config — contains a live Context7 API key.
.mcp.json

# Playwright MCP scratch output: page snapshots, console logs, baseline shots.
.playwright-mcp/

# Playwright's own failure output: traces, screenshots and error context,
# written per failing test and regenerated on every run.
test-results/
playwright-report/

